import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, Lambda, Dense

# 1. Prepare text
text = "i love eating mango i love eating apple"

words = text.lower().split()

# 2. Create vocabulary
vocab = list(set(words))

word_to_index = {w: i for i, w in enumerate(vocab)}
index_to_word = {i: w for w, i in word_to_index.items()}

# 3. Generate training data
X = []
Y = []

for i in range(1, len(words)-1):
    context = [words[i-1], words[i+1]]

    X.append([word_to_index[w] for w in context])
    Y.append(word_to_index[words[i]])

X = np.array(X)
Y = np.array(Y)

# 4. Build CBOW model
model = Sequential([
    Embedding(len(vocab), 10, input_length=2),
    Lambda(lambda x: tf.reduce_mean(x, axis=1)),
    Dense(len(vocab), activation='softmax')
])

# 5. Compile model
model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

# 6. Train model
model.fit(X, Y, epochs=200, verbose=0)

# 7. Predict missing word
context = ["love", "mango"]

input_data = np.array([
    [word_to_index[w] for w in context]
])

prediction = model.predict(input_data, verbose=0)

predicted_word = index_to_word[np.argmax(prediction)]

print("Context Words:", context)
print("Predicted Word:", predicted_word)



