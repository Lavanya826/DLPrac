import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt

from tensorflow.keras import layers, Model

# 1. Create normal data
normal = np.random.normal(0, 1, (500, 4))

# 2. Create abnormal data
anomaly = np.random.normal(5, 1, (50, 4))

# 3. Split normal data
train = normal[:400]
test = np.concatenate([normal[400:], anomaly])

# 4. Build Encoder
input_data = layers.Input(shape=(4,))

encoded = layers.Dense(2, activation='relu')(input_data)

# 5. Build Decoder
decoded = layers.Dense(4, activation='linear')(encoded)

# 6. Create Autoencoder
autoencoder = Model(input_data, decoded)

# 7. Compile model
autoencoder.compile(
    optimizer='adam',
    loss='mse'
)

# 8. Train model using normal data
autoencoder.fit(
    train, train,
    epochs=30,
    batch_size=16,
    verbose=0
)

# 9. Calculate reconstruction error
prediction = autoencoder.predict(test)

error = np.mean((test - prediction) ** 2, axis=1)

# 10. Set threshold
threshold = np.mean(
    np.mean((train - autoencoder.predict(train)) ** 2, axis=1)
) + 3 * np.std(
    np.mean((train - autoencoder.predict(train)) ** 2, axis=1)
)

# 11. Detect anomalies
result = error > threshold

print("Threshold:", threshold)
print("Anomalies detected:", np.sum(result))

# 12. Plot errors
plt.plot(error)
plt.axhline(threshold, color='red')
plt.xlabel("Data Samples")
plt.ylabel("Reconstruction Error")
plt.title("Anomaly Detection")
plt.show()



